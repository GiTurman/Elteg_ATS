#!/bin/bash
# მორიგეების Dial() სტრიქონი აპის „ცვლებიდან“ (ხელმძღვანელი → მორიგე ტექნიკოსი).
# ავტორი: Giorgi Turmanidze "GT"
[ -f /etc/pbx.env ] && . /etc/pbx.env
raw=$(curl -fsS --max-time 4 -H "X-Webhook-Token: ${WEBHOOK_TOKEN}" \
  "${APP_URL%/}/api/public/telephony/on-duty?format=dial" 2>/dev/null) || exit 0
out=()
IFS='&' read -ra parts <<< "$raw"
for p in "${parts[@]}"; do
  if [[ "$p" =~ ^PJSIP/([0-9]{2,6})$ ]]; then
    out+=("$p")
  elif [[ "$p" =~ ^PJSIP/([0-9+]{5,16})@trunk$ ]]; then
    out+=("PJSIP/$(/usr/local/bin/pbx-fmtnum "${BASH_REMATCH[1]}")@trunk")
  fi
done
(IFS='&'; printf '%s' "${out[*]}")
