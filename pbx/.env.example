# ===== GT-ATS სადგურის პარამეტრები =====
# ავტორი: Giorgi Turmanidze "GT"

# აპის მისამართი (ტელეფონიის გვერდზე წერია „APP_URL=…“)
APP_URL=https://liftdispelteg.lovable.app
# ვებჰუკის ტოკენი (ტელეფონიის გვერდი → ტოკენი → კოპირება)
WEBHOOK_TOKEN=

# სადგურის დომენი (DNS A-ჩანაწერი სერვერის IP-ზე) და სერვერის საჯარო IP
PBX_DOMAIN=pbx.example.ge
PUBLIC_IP=

# ჩანაწერების ბმულის საიდუმლო ნაწილი (შემთხვევითი, მაგ.: openssl rand -hex 16)
REC_SECRET=
# ჩანაწერების შენახვის ვადა დღეებში
REC_RETENTION_DAYS=180

# მთავარი ნომერი (გამავალ ზარზე გამოჩნდება)
MAIN_NUMBER=0322770200

# ===== ოპერატორის SIP ხაზი (Silknet / Magti / სხვა) =====
TRUNK_HOST=
TRUNK_PORT=5060
TRUNK_USER=
TRUNK_PASS=
# SIP დომენი, თუ ოპერატორმა ცალკე მოგცათ (თუ არა — ცარიელი, გამოიყენება TRUNK_HOST)
TRUNK_DOMAIN=
# yes — სადგური თავად რეგისტრირდება ოპერატორთან; no — ოპერატორი IP-ით გვცნობს
TRUNK_REGISTER=yes
# ოპერატორის დამატებითი IP-ები შემომავალი ზარების ამოსაცნობად (მძიმით), თუ აქვთ
TRUNK_MATCH=
# გამავალი ნომრის ფორმატი ოპერატორისთვის: national (599123456 / 322770200),
# national0 (0599123456), e164 (+995599123456), intl00 (00995599123456)
OUTBOUND_FORMAT=national

# ===== რიგი =====
# რამდენ წამს ელოდება აბონენტი ოპერატორებს, სანამ ხელმძღვანელზე/მორიგეზე გადავა
QUEUE_TIMEOUT=40
# რამდენ წამს რეკავს ხელმძღვანელთან/მორიგე ტექნიკოსთან
OVERFLOW_TIMEOUT=30
